NODE_ENV=development
PORT=4100
FRONTEND_URL=http://localhost:3100
DATABASE_URL=postgres://aigenerate:aigenerate@localhost:5435/aigenerate
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash
STORAGE_DIR=./storage
# Transactional email. Leave SMTP_HOST empty in development: emails are saved to STORAGE_DIR/mail-outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="intexa-ai.com <support@intexa-ai.com>"
# Team notifications in a Telegram forum topic (registration, payment, failed order confirmation)
TG_BOT_TOKEN=
TG_CHAT_ID=-1004333653026
TG_TOPIC_ID=12915

# Wemopay shop for intexa-ai.com. Amounts use USD to match plans and accounting.
WEMOPAY_API_URL=
WEMOPAY_API_KEY=
WEMOPAY_SIGNING_KEY=

# Character replacement (Alibaba Model Studio; independent of OpenRouter)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Optional dedicated Model Studio credentials/endpoint for voice-reference Wan 3.0.
# Defaults to DASHSCOPE_API_KEY and DASHSCOPE_BASE_URL above.
DASHSCOPE_VOICE_API_KEY=
DASHSCOPE_VOICE_BASE_URL=

# Enable only after activating Wan 3.0 in the matching Model Studio region.
DASHSCOPE_VOICE_ENABLED=false
